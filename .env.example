# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
SAMPLE_MODE=false          # true = no Zetaris, no Nightshift, no network: cached data + deterministic fallback
DOMAIN=project_memory      # folder under domains/ (admin = the second pack)
DATA_SCHEMA=osef           # Zetaris datasource name (tables: osef.rules, osef.senders, osef.profile)
LOG_LEVEL=INFO
PORT=8000

# --- DATA: Zetaris (API key created in the Zetaris UI, http://localhost:3000) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# --- POWER: Meterless Nightshift (URL and token from the Nightshift Console) ---
# The NVIDIA key does NOT go here: it goes in Nightshift > Setup > Providers.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Nemotron lanes, by the exact ids Nightshift lists (verified through Nightshift on 27/10/2026):
# nvidia/nemotron-3.5-lightning-30b-a3b answers in about 2 s, nvidia/nemotron-3-ultra-550b-a55b is the strong one,
# nvidia/nemotron-3-super-120b returns a 404 from NVIDIA. `python scripts/configure_nightshift.py` checks and writes them.
METERLESS_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_MODEL_JUDGE=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_MODEL=meterless/auto      # fallback routing mode if a lane id is not available
RECORD_LLM=true            # record real responses to data/llm_cache.jsonl for replay in SAMPLE_MODE

# --- BUILD: Meterless H-MEM engine (hmem-service/) ---
HMEM_URL=http://127.0.0.1:8787
# The team's Atlas engines (services/hmem, services/world_model; a different API around the same references)
# ATLAS_HMEM_URL=http://127.0.0.1:8765
# WORLD_MODEL_URL=http://127.0.0.1:8766
HMEM_SPACE=default

# --- OSEF Steward (domain project_memory) ---
STEWARD_SPACE=project      # which company memory the console and the MCP server use
ZETARIS_USE_USL=false      # true = read through the Unified Semantic Layer (scripts/zetaris/register_steward.sql)
# Per AI client, set in its MCP config (docs/mcp/*.json), not here:
# OSEF_MEMBER="Claire Morel"   OSEF_AI_TOOL=Claude

# --- Atlas modules (atlas/, the team's coordination and provider code) ---
# Same Nightshift as above; atlas.llm also reads the runtime token from .settings.json (git-ignored)
# or from METERLESS_STATE_DIR/proxy-token, written by Nightshift itself.
LLM_PROVIDER=meterless
METERLESS_STATE_DIR=
NIGHTSHIFT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TRACE_FILE=
# Optional OpenAI-compatible route for atlas.structured (not independent of Nightshift when it points at it)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=
NEMOTRON_MODEL=
