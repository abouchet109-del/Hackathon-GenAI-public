# Copie de référence sans secrets. Les vraies valeurs vont dans .env (ignoré par git).

# --- DATA : Zetaris (installation locale) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Clé créée par toi dans l'interface Zetaris (menu utilisateur > API keys)
ZETARIS_API_KEY=

# --- POWER : route Nemotron (les 3 valeurs doivent venir de la MÊME route) ---
# Option A, Meterless Nightshift : URL + clé affichées dans la Console de Nightshift
#   MODEL_BASE_URL=http://127.0.0.1:8088/v1
#   NEMOTRON_MODEL=un modèle meterless/* qui pointe vers une lane Nemotron
# Option B, API gratuite NVIDIA : clé nvapi-... depuis build.nvidia.com
#   MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#   NEMOTRON_MODEL=l'ID exact du modèle Nemotron sur build.nvidia.com
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=
NEMOTRON_MODEL=

# --- Réglages du provider Meterless dans l'app (règle Power) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Modèle imposé dans Nightshift pour les agents (identifiant listé par /v1/models)
NIGHTSHIFT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# true : Zetaris et le modèle sont lus dans les caches de data/cache/, sans réseau
SAMPLE_MODE=false
# Trace JSONL des appels LLM (défaut : logs/llm-trace.jsonl)
LLM_TRACE_FILE=

# Provider principal de l'app : meterless (Nightshift) ou openai (route MODEL_*)
LLM_PROVIDER=meterless
# Optionnel : dossier d'état de Nightshift, où le runtime écrit son token (proxy-token)
METERLESS_STATE_DIR=
