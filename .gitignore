# Secrets: never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc

# Local provider settings (holds the Meterless runtime token)
.settings.json
.test-tmp/

# Third-party material not yet reviewed (e.g. the Atlas kit)
external/

# Node (if the Meterless reference engines are used)
node_modules/

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
